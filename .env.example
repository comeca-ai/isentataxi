# ── IsentaTáxi 2.0 — self-host ──────────────────────────────────────────────
# Copie para .env e ajuste os valores:  cp .env.example .env

# Banco de dados MySQL (string de conexão completa).
# No docker-compose fornecido, o host é "mysql" e as credenciais abaixo
# já combinam com o serviço mysql do compose — troque apenas a senha.
DATABASE_URL=mysql://isentataxi:TROCAR_SENHA@mysql:3306/isentataxi

# Segredo longo e aleatório usado para assinar os tokens JWT de sessão.
# Gere um com:  openssl rand -base64 48
JWT_SECRET=TROCAR_SEGREDO_LONGO

# Porta HTTP do servidor (o compose expõe 3000:3000).
PORT=3000

# Bootstrap do primeiro administrador (opcional mas recomendado):
# no primeiro boot, se não existir usuário com este e-mail, ele é criado
# com role "admin" e a senha abaixo. Depois você pode remover estas vars.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Senha do banco usada pelo serviço mysql do docker-compose.
# Deve ser a mesma senha presente em DATABASE_URL.
MYSQL_PASSWORD=TROCAR_SENHA

# E-mails transacionais (boas-vindas, doc aprovado/rejeitado) via Resend.
# Crie a conta em https://resend.com, verifique o domínio e gere a API key.
# Vazio = e-mails desligados (no-op com log) — o app funciona normal sem isso.
RESEND_API_KEY=
EMAIL_FROM=IsentaTáxi <ola@isentataxi.com.br>
